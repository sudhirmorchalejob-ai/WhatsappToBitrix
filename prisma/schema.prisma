// ------------------------------------------------------------------
// WhatsBox <-> Bitrix24 Multi-Tenant integration schema (PostgreSQL)
// ------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------- Enums -------------------------------

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  DOCUMENT
  PDF
  LOCATION
  CONTACT
  STICKER
  UNKNOWN
}

enum MessageState {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum WebhookSource {
  WHATSBOX
  META
  BITRIX24
}

enum CampaignStatus {
  DRAFT
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum CampaignType {
  TEXT
  MEDIA
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  TENANT_ADMIN
  USER
}

// ------------------------------- Models ------------------------------

model Tenant {
  id                    Int          @id @default(autoincrement())
  name                  String       @db.VarChar(255)
  slug                  String       @unique @db.VarChar(100)
  status                String       @default("ACTIVE") @db.VarChar(20)

  // Integration credentials per tenant
  whatsappWebhookUrl   String?      @db.VarChar(255)
  whatsboxChannelId    String?      @db.VarChar(255)
  whatsboxWebhookSecret String?     @db.VarChar(255)

  bitrix24WebhookUrl    String?      @db.VarChar(500)
  bitrix24WebhookSecret String?      @db.VarChar(255)

  isConfigured          Boolean      @default(false)
  lastSyncedAt          DateTime?

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  users                 User[]
  contacts              Contact[]
  conversations         Conversation[]
  messages              Message[]
  agents                Agent[]
  settings              Setting[]
  installs              Install[]
  webhookLogs           WebhookLog[]
  templates             Template[]
  autoReplyLogs         AutoReplyLog[]
  activityLogs          ActivityLog[]
  campaigns             Campaign[]
  connectorLineMappings ConnectorLineMapping[]

  @@map("tenants")
}

model User {
  id           Int        @id @default(autoincrement())
  tenantId     Int?
  email        String     @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  name         String     @db.VarChar(255)
  role         UserRole   @default(ADMIN)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activityLogs ActivityLog[]

  @@index([tenantId])
  @@map("users")
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  tenantId     Int?
  userId       Int?
  action       String   @db.VarChar(100)
  category     String   @default("SYSTEM") @db.VarChar(50)
  details      Json?
  ipAddress    String?  @db.VarChar(50)
  createdAt    DateTime @default(now())

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Contact {
  id                Int      @id @default(autoincrement())
  tenantId          Int?
  whatsappPhone     String   @db.VarChar(20)
  firstName         String?  @db.VarChar(255)
  lastName          String?  @db.VarChar(255)
  name              String?  @db.VarChar(255)
  email             String?  @db.VarChar(255)
  company           String?  @db.VarChar(255)
  avatarUrl         String?  @db.VarChar(500)
  isBlocked         Boolean  @default(false)
  lastActivityAt    DateTime?
  bitrix24ContactId Int?
  syncStatus        SyncStatus @default(PENDING)
  createdVia        String     @default("WHATSAPP") @db.VarChar(20)
  meta              Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  messages          Message[]
  autoReplyLogs     AutoReplyLog[]

  @@unique([tenantId, whatsappPhone])
  @@index([tenantId])
  @@map("contacts")
}

model Conversation {
  id                   Int                @id @default(autoincrement())
  tenantId             Int?
  contactId            Int
  channelNumber        String             @db.VarChar(20)
  provider             WebhookSource      @default(WHATSBOX)
  phoneNumberId        String?            @db.VarChar(64)
  status               ConversationStatus @default(OPEN)
  whatsappThreadId     String?            @db.VarChar(255)
  bitrix24ThreadId     String?            @db.VarChar(255)
  bitrix24ExternalChatId String?          @db.VarChar(255)
  leadId               Int?
  lastMessageAt        DateTime?
  lastMessagePreview   String?            @db.VarChar(500)
  lastMessageDirection MessageDirection?
  lastMessageType      MessageType?
  unreadCount          Int                @default(0)
  assignedAgentId      Int?
  closedAt             DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact              Contact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignedAgent        Agent?             @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  messages             Message[]
  assignments          ConversationAssignment[]
  autoReplyLogs        AutoReplyLog[]

  @@unique([contactId, channelNumber])
  @@index([tenantId])
  @@index([status])
  @@index([assignedAgentId])
  @@index([lastMessageAt])

  @@map("conversations")
}

model Message {
  id                Int             @id @default(autoincrement())
  tenantId          Int?
  conversationId    Int
  contactId         Int
  leadId            Int?
  campaignId        Int?
  whatsboxMessageId String?         @db.VarChar(255)
  wamid             String?         @db.VarChar(255)
  direction         MessageDirection
  type              MessageType     @default(UNKNOWN)
  body              String?         @db.Text
  caption           String?         @db.VarChar(1000)
  mediaUrl          String?         @db.VarChar(2000)
  mediaMimeType     String?         @db.VarChar(255)
  mediaName         String?         @db.VarChar(255)
  mediaSize         Int?
  locationData      Json?
  contactCard       Json?
  payload           Json?
  timestamp         DateTime        @default(now())
  status            MessageState    @default(PENDING)
  error             String?         @db.Text
  retryCount        Int             @default(0)
  sentAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact           Contact         @relation(fields: [contactId], references: [id], onDelete: Restrict)
  campaign          Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  statuses          MessageStatus[]
  autoReplyLogs     AutoReplyLog[]

  @@index([tenantId])
  @@index([conversationId, timestamp])
  @@index([contactId, timestamp])
  @@index([campaignId])
  @@index([status])

  @@map("messages")
}

model Campaign {
  id              Int            @id @default(autoincrement())
  tenantId        Int?
  name            String         @db.VarChar(255)
  type            CampaignType   @default(TEXT)
  status          CampaignStatus @default(DRAFT)
  body            String?        @db.Text
  mediaUrl        String?        @db.VarChar(2000)
  mediaName       String?        @db.VarChar(255)
  caption         String?        @db.VarChar(1000)
  createdVia      String         @default("WHATSAPP") @db.VarChar(20)
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  deliveredCount  Int            @default(0)
  readCount       Int            @default(0)
  failedCount     Int            @default(0)
  error           String?        @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant           Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages         Message[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model Agent {
  id                Int          @id @default(autoincrement())
  tenantId          Int?
  bitrix24UserId    Int
  name              String       @db.VarChar(255)
  email             String?      @db.VarChar(255)
  phone             String?      @db.VarChar(50)
  avatarUrl         String?      @db.VarChar(500)
  whatsappChannelId String?      @db.VarChar(255)
  isActive          Boolean      @default(true)
  isSupervisor      Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  assignments       ConversationAssignment[]

  @@unique([tenantId, bitrix24UserId])
  @@index([tenantId])
  @@map("agents")
}

model Setting {
  id          Int      @id @default(autoincrement())
  tenantId    Int?
  key         String   @db.VarChar(100)
  value       Json
  type        String   @default("string") @db.VarChar(20)
  description String?  @db.VarChar(500)
  isSecret    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("settings")
}

model Install {
  id               Int      @id @default(autoincrement())
  tenantId         Int?
  memberId         String   @db.VarChar(64)
  domain           String   @db.VarChar(255)
  clientEndpoint   String?  @db.VarChar(500)
  accessToken      String   @db.VarChar(1024)
  refreshToken     String   @db.VarChar(1024)
  applicationToken String?  @db.VarChar(255)
  connectorId      String?  @db.VarChar(64)
  lineId           Int?
  userId           Int?
  scope            String?  @db.VarChar(255)
  status           String   @default("INSTALLED") @db.VarChar(20)
  expiresAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberId])
  @@index([tenantId])
  @@index([status, updatedAt])
  @@map("bitrix24_installs")
}

model WebhookLog {
  id           Int          @id @default(autoincrement())
  tenantId     Int?
  source       WebhookSource
  eventType    String       @db.VarChar(100)
  payload      Json?
  status       String       @default("RECEIVED") @db.VarChar(20)
  httpCode     Int?
  errorMessage String?      @db.Text
  ip           String?      @db.VarChar(50)
  signature    String?      @db.VarChar(255)
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([source, createdAt])
  @@index([status])

  @@map("webhook_logs")
}

model MessageStatus {
  id             Int          @id @default(autoincrement())
  messageId      Int
  status         MessageState
  providerStatus String?      @db.VarChar(50)
  attempt        Int          @default(1)
  error          String?      @db.Text
  raw            Json?
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, timestamp])

  @@map("message_statuses")
}

model ConversationAssignment {
  id                Int      @id @default(autoincrement())
  conversationId    Int
  agentId           Int
  assignedByAgentId Int?
  isActive          Boolean  @default(true)
  assignedAt        DateTime @default(now())
  unassignedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent             Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([conversationId])
  @@index([agentId, isActive])

  @@map("conversation_assignments")
}

model Template {
  id         Int      @id @default(autoincrement())
  tenantId   Int?
  name       String   @db.VarChar(255)
  body       String   @db.Text
  category   String?  @db.VarChar(100)
  isActive   Boolean  @default(true)
  isDefault  Boolean  @default(false)
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  autoReplyLogs AutoReplyLog[]

  @@index([tenantId])
  @@index([isActive])
  @@index([category])
  @@map("templates")
}

model AutoReplyLog {
  id             Int      @id @default(autoincrement())
  tenantId       Int?
  contactId      Int
  conversationId Int
  messageId      Int
  templateId     Int?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  template     Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([contactId, createdAt])
  @@index([conversationId])
  @@map("auto_reply_logs")
}

model ConnectorLineMapping {
  id               Int      @id @default(autoincrement())
  tenantId         Int?
  memberId         String   @db.VarChar(64)
  domain           String   @db.VarChar(255)
  connectorId      String   @default("whatsapp_b24_connector") @db.VarChar(64)
  lineId           Int
  lineName         String?  @db.VarChar(255)
  status           String   @default("ACTIVE") @db.VarChar(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("connector_line_mappings")
}
