# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
NODE_ENV=development
APP_NAME=whatsapp-b24-integration
HOST=0.0.0.0
PORT=9191

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_b24_integration"

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE_ENABLED=true

# ------------------------------------------------------------------
# API security (internal)
# Comma-separated API keys accepted by the `x-api-key` header.
# ------------------------------------------------------------------
API_KEYS="change-me"
CORS_ORIGIN="*"

# Set to true when running behind a reverse proxy (nginx/load balancer)
TRUST_PROXY=false

# Rate limiting (window in ms, max requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Webhook endpoints get a higher burst allowance from the provider
WEBHOOK_RATE_LIMIT_MAX=600

# ------------------------------------------------------------------
# Background jobs
# ------------------------------------------------------------------
# Enables the retry/resync workers (retry stuck outgoing messages, push
# locally-created contacts up to Bitrix24).
RETRY_ENABLED=true
RETRY_INTERVAL_MS=300000
# Max attempts before an outgoing message is marked FAILED permanently
OUTGOING_MAX_RETRIES=3

# ------------------------------------------------------------------
# WhatsBox API (WhatsApp gateway — the ONLY WhatsApp provider used)
# ------------------------------------------------------------------
WHATSBOX_API_URL="https://api.whatsbox.io"
WHATSBOX_API_KEY=""
WHATSBOX_CHANNEL_ID=""
WHATSBOX_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# WhatsApp webhook (per-tenant default)
# The public URL where the WhatsApp gateway delivers events. Saved per
# tenant via the wizard / Integration Settings; this is only a fallback
# default for tenants that have not saved their own webhook yet.
# ------------------------------------------------------------------
WHATSAPP_WEBHOOK_URL=""

# ------------------------------------------------------------------
# WhatsApp Business API (Meta Graph API via BSP proxy)
# Used to fetch message templates and interact with the WABA.
# ------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WABA_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_BASE_URL="https://crmapi.1automations.com/api/meta"

# ------------------------------------------------------------------
# Bitrix24 (inbound webhook URL, e.g. https://company.bitrix24.com/rest/1/abc123/)
# ------------------------------------------------------------------
BITRIX24_WEBHOOK_URL=""
BITRIX24_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Bitrix24 Marketplace app / OAuth
# Client id + secret come from the partner area (or /local/dev for a
# local app). The app exchanges install tokens at oauth.bitrix.info.
# ------------------------------------------------------------------
BITRIX24_CLIENT_ID=""
BITRIX24_CLIENT_SECRET=""
# Optional: pin the middleware to a single portal in dev (member_id).
# Leave empty to use the most recently installed portal.
BITRIX24_MEMBER_ID=""
BITRIX24_OAUTH_TOKEN_URL="https://oauth.bitrix.info/oauth/token/"

# Public URL of this app; used to build the ON_APP_UNINSTALL event
# handler URL (e.g. https://app.example.com -> /uninstall)
# Leave empty on Render/Railway: the app auto-falls-back to
# RENDER_EXTERNAL_URL / RAILWAY_PUBLIC_DOMAIN. Set it manually only for
# a custom domain.
APP_BASE_URL=""

# ------------------------------------------------------------------
# SMS gateway (Bitrix24 message provider) defaults.
# Tenants can override each of these from the Dashboard -> SMS Gateway
# (stored per-tenant; API_KEY and WEBHOOK_SECRET are stored as secrets
# and never echoed back).
# ------------------------------------------------------------------
# Provider: "msg91" (MSend endpoint built in) or "generic" (POSTs
# {"to","message"} JSON to SMS_API_URL).
SMS_PROVIDER="generic"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_ROUTE=""
SMS_TEMPLATE_ID=""
# Shared secret used to verify delivery reports hitting /webhooks/sms
# (via ?secret=, body secret, x-sms-secret, or x-sms-signature HMAC).
SMS_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Open Channels connector (Phase 5)
# ------------------------------------------------------------------
# Connector id registered on every portal. Lowercase, no dots, underscore
# separator (Bitrix24 rule). This is the CONNECTOR value used everywhere.
BITRIX24_CONNECTOR_ID="wa_whatsapp"
# Optional open line id for automatic activation on install. Leave 0 to
# require the operator to activate from the Contact Center placement page
# (GET /app/connector); the chosen line is then stored per portal.
BITRIX24_OPENLINE_ID=0

# Open Channels connector module feature flag (set true to enable
# imconnector.register / imconnector.send.messages / event binding).
ENABLE_OPENLINES_CONNECTOR=false

# ------------------------------------------------------------------
# Operator routing (Phase 6)
# ------------------------------------------------------------------
# Auto-assign incoming chats to an available operator.
ROUTING_ENABLED=true
# least-loaded (fewest open chats first) | round-robin (longest-waiting first)
ROUTING_STRATEGY=least-loaded
# Skip an agent that already has this many open chats.
ROUTING_MAX_ACTIVE_PER_AGENT=100
# Exclude supervisors from auto-assignment (they can still take over).
ROUTING_EXCLUDE_SUPERVISORS=true
